---
import '../styles/global.css';
import { dictionary, type Locale } from '../i18n';
import { config, content } from '../lib/site';
import { pagePath } from '../lib/routes';
interface Props { title: string; description: string; locale: Locale; path: string; counterpart?: string | null; indexable?: boolean; isHome?: boolean; }
const {title,description,locale,path,counterpart,indexable=true,isHome=false}=Astro.props;
const t=dictionary(locale);
const url=new URL(path,config.SITE_URL).href;
const isIndexed=indexable && config.DEPLOY_ENV==='production';
const enPath=locale==='en'?path:counterpart;
const zhPath=locale==='zh'?path:counterpart;
const categories=content.categories.filter(c=>content.projects.some(p=>p.primary_category===c.id || p.secondary_categories.includes(c.id)));
const languageLabel=counterpart ? (locale==='en'?'Switch to 简体中文':'Switch to English') : (locale==='en'?'前往中文首页':'Go to English home');
const documentTitle=`${title} · ${config.SITE_NAME}`;
const socialImage=new URL('/images/jev-atlas-social.png',config.SITE_URL).href;
const socialImageAlt=locale==='zh'?'Jev Atlas 科技风格项目目录预览':'Jev Atlas technology project directory preview';
const homePath=pagePath(locale);
const projectsPath=pagePath(locale,'projects/');
const categoryPath=pagePath(locale,'categories/');
const aboutPath=pagePath(locale,'about/');
const submitPath=pagePath(locale,'submit/');
---
<!doctype html>
<html lang={locale==='zh'?'zh-Hans':'en'}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title><meta name="description" content={description} />
    <meta name="robots" content={isIndexed?'index,follow':'noindex,follow'} /><link rel="canonical" href={url} />
    {enPath && <link rel="alternate" hreflang="en" href={new URL(enPath,config.SITE_URL).href} />}
    {zhPath && <link rel="alternate" hreflang="zh-Hans" href={new URL(zhPath,config.SITE_URL).href} />}
    {enPath && <link rel="alternate" hreflang="x-default" href={new URL(enPath,config.SITE_URL).href} />}
    <meta property="og:site_name" content={config.SITE_NAME} /><meta property="og:title" content={documentTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={url} /><meta property="og:type" content="website" />
    <meta property="og:locale" content={locale==='zh'?'zh_CN':'en_US'} /><meta property="og:locale:alternate" content={locale==='zh'?'en_US':'zh_CN'} />
    <meta property="og:image" content={socialImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={documentTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} /><meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/favicon-tech-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-tech-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-tech.png" sizes="180x180" />
    <slot name="head" />
    {config.DEPLOY_ENV==='production' && config.PUBLIC_WEB_ANALYTICS_TOKEN && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:config.PUBLIC_WEB_ANALYTICS_TOKEN})}></script>}
  </head>
  <body>
    <a href="#main" class="skip-link">{locale==='zh'?'跳至内容':'Skip to content'}</a>
    <header class="site-header system-bar border-b border-line">
      <div class="shell header-inner">
        <a href={homePath} class="site-brand" aria-label={config.SITE_NAME} aria-current={path===homePath?'page':undefined}><img class="brand-mark" src="/images/jev-mark-tech.png" width="32" height="32" alt="" /><span>Jev <span>Atlas</span></span></a>
        <nav aria-label={locale==='zh'?'主导航':'Main navigation'} class="site-nav text-sm">
          <a class="inline-flex min-h-11 items-center" href={projectsPath} aria-current={path.startsWith(projectsPath)?'page':undefined}>{t.projects}</a>
          {categories.length>0 && <details class="relative"><summary class:list={{'nav-current':path.startsWith(categoryPath)}} aria-current={path.startsWith(categoryPath)?'page':undefined}>{t.categories}</summary><div class="absolute left-0 top-full z-10 min-w-56 border border-line bg-surface p-2">{categories.map(c=><a class="block px-3 py-3" href={pagePath(locale,`categories/${c.id}/`)}>{c[locale]}</a>)}</div></details>}
          <a class="nav-about" href={aboutPath} aria-current={path===aboutPath?'page':undefined}>{t.about}</a>
          <a class="nav-submit" href={submitPath} aria-current={path===submitPath?'page':undefined}>{t.submit}</a>
        </nav>
        <a id="language-switch" class="language-switch" href={counterpart || pagePath(locale==='en'?'zh':'en')} lang={locale==='en'?'zh-Hans':'en'} aria-label={languageLabel} title={languageLabel}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></svg></a>
      </div>
    </header>
    <main id="main" class:list={['shell min-h-[65vh]', isHome ? 'home-main pb-10 md:pb-14' : 'py-10 md:py-14']}><slot /></main>
    <footer class="site-footer"><div class="shell footer-grid"><div><a class="footer-brand" href={pagePath(locale)}>{config.SITE_NAME}</a><p>{t.independent} {t.sourceChecked}</p></div><nav aria-label={locale==='zh'?'目录':'Directory'}><strong>{t.projects}</strong><a href={pagePath(locale,'projects/')}>{t.viewAll}</a><a href={pagePath(locale,'search/')}>{t.search}</a><a href={pagePath(locale,'submit/')}>{t.submit}</a></nav><nav aria-label={locale==='zh'?'关于':'About'}><strong>{t.about}</strong><a href={pagePath(locale,'about/')}>{t.about}</a><a href={pagePath(locale,'privacy/')}>{t.privacy}</a><a href={pagePath(locale,'sponsor/')}>{t.sponsor}</a></nav></div></footer>
    <script>
      import '../scripts/motion';
      const link=document.querySelector<HTMLAnchorElement>('#language-switch');
      if(link && location.pathname.includes('/search/')) link.search=location.search;
    </script>
  </body>
</html>
