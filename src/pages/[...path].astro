---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoPage from '../components/InfoPage.astro';
import Pagination from '../components/Pagination.astro';
import ProjectDetail from '../components/ProjectDetail.astro';
import ProjectList from '../components/ProjectList.astro';
import Search from '../components/Search.astro';
import { content, manifest, config } from '../lib/site';
import { dictionary } from '../i18n';
import { pagePath, paginationPath, type Route } from '../lib/routes';
import { structuredData, serializeStructuredData } from '../lib/seo';

export function getStaticPaths() {
  return manifest.map((route) => ({
    params: { path: route.path === '/' ? undefined : route.path.replace(/^\//, '').replace(/\/$/, '') },
    props: { route },
  }));
}

interface Props { route: Route }
const { route } = Astro.props;
const locale = route.locale;
const t = dictionary(locale);
const date = (value: string) => new Date(value).toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', { dateStyle: 'medium', timeZone: 'UTC' });
const activeCategories = content.categories.filter((category) => content.projects.some((p) => p.primary_category === category.id || p.secondary_categories.includes(category.id)));

const openSourceCount = content.projects.filter((p) => p.source_status === 'open_source').length;
const snapshotDate = content.projects.reduce((latest, p) => (p.checked_at > latest ? p.checked_at : latest), '');
const stats = t.homeStats.replace('{total}', String(content.projects.length)).replace('{openSource}', String(openSourceCount)).replace('{date}', snapshotDate ? date(snapshotDate) : t.unknown);

const baseTitle = route.kind === 'home' ? t.hero
  : route.kind === 'directory' ? t.projects
  : route.kind === 'search' ? t.search
  : route.kind === 'project' ? (route.project?.name ?? '')
  : route.kind === 'category' ? (route.category?.[locale] ?? '')
  : t[route.kind];
const pageTitle = route.pages>1 ? `${baseTitle} · ${t.paginationStatus.replace('{page}',String(route.page)).replace('{pages}',String(route.pages))}` : baseTitle;
const pageDescription = route.kind === 'project' ? (route.project?.locales[locale] ?? route.project?.locales.en)?.summary ?? t.intro
  : route.kind === 'sponsor' ? `${t.cooperation} ${t.cooperationBody}`
  : route.kind === 'submit' ? t.free
  : route.kind === 'category' ? t.categoryIntro.replace('{category}', route.category?.[locale] ?? '')
  : t.intro;
const listCount = t.directoryCount.replace('{count}', String(route.total));
const prevLink = route.page > 1 ? paginationPath(route,route.page-1) : null;
const nextLink = route.page < route.pages ? paginationPath(route,route.page+1) : null;
---
<BaseLayout title={pageTitle} description={pageDescription} locale={locale} path={route.path} counterpart={route.counterpart} indexable={route.indexable}>
  {route.kind === 'home' && <>
    <section class="grid gap-4 text-center">
      <p class="badge mx-auto">{t.kicker}</p>
      <h1>{t.hero}</h1>
      <p class="muted mx-auto max-w-2xl text-lg">{t.intro}</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a class="button button-primary" href={pagePath(locale, 'projects/')}>{t.browse}</a>
        <a class="button" href={pagePath(locale, 'submit/')}>{t.submit}</a>
      </div>
    </section>

    <form class="mx-auto mt-10 max-w-2xl" method="get" action={pagePath(locale, 'search/')}>
      <label class="mb-2 block text-sm" for="home-q">{t.search}</label>
      <div class="flex gap-2">
        <input id="home-q" name="q" type="search" placeholder={t.searchHint} maxlength="200" />
        <button class="button button-primary" type="submit">{t.search}</button>
      </div>
    </form>

    <p class="muted mt-8 text-center text-sm">{stats}</p>

    <section class="panel mt-8 flex flex-wrap items-center justify-between gap-4">
      <p><span class="font-semibold">{t.cooperation}</span> <span class="muted">{t.cooperationBody}</span></p>
      <a class="button" href={pagePath(locale, 'sponsor/')}>{t.askSponsor}</a>
    </section>

    <section class="mt-10">
      <h2>{t.categories}</h2>
      <div class="flex flex-wrap gap-2">
        <a class="button" href={pagePath(locale, 'projects/')}>{t.all}</a>
        {activeCategories.map((category) => <a class="button" href={pagePath(locale, `categories/${category.id}/`)}>{category[locale]}</a>)}
      </div>
    </section>

    <section class="mt-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2>{t.latest}</h2>
        <a class="text-link" href={pagePath(locale, 'projects/')}>{t.viewAll} →</a>
      </div>
      <ProjectList projects={route.projects} locale={locale} />
    </section>

    <section class="panel mt-10 flex flex-wrap items-center justify-between gap-4">
      <p class="muted max-w-xl">{t.free}</p>
      <a class="button button-primary" href={pagePath(locale, 'submit/')}>{t.submit}</a>
    </section>
  </>}

  {route.kind === 'directory' && <>
    <h1>{pageTitle}</h1>
    <p class="muted">{listCount} · <a class="text-link" href={pagePath(locale, 'search/')}>{t.filterHint}</a></p>
    <div class="mt-6"><ProjectList projects={route.projects} locale={locale} /></div>
    <Pagination route={route} />
  </>}

  {route.kind === 'category' && route.category && <>
    <p class="muted text-sm"><a class="text-link" href={pagePath(locale, 'projects/')}>{t.projects}</a> / {route.category[locale]}</p>
    <h1>{pageTitle}</h1>
    <p class="muted">{t.categoryIntro.replace('{category}', route.category[locale])} · {listCount}</p>
    <div class="mt-6"><ProjectList projects={route.projects} locale={locale} /></div>
    <Pagination route={route} />
  </>}

  {route.kind === 'project' && route.project && <ProjectDetail project={route.project} locale={locale} />}

  {route.kind === 'search' && <Search locale={locale} />}

  {(route.kind === 'submit' || route.kind === 'sponsor' || route.kind === 'about' || route.kind === 'privacy') && <InfoPage kind={route.kind} locale={locale} />}

  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={serializeStructuredData(structuredData(route,pageTitle,config.SITE_URL))} />
    {prevLink && <link rel="prev" href={prevLink} />}
    {nextLink && <link rel="next" href={nextLink} />}
  </Fragment>
</BaseLayout>
