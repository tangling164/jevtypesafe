---
import type { PublicProject } from '../lib/content-schema';
import {dictionary,type Locale} from '../i18n';
import {projectPath} from '../lib/routes';
import {content} from '../lib/site';
interface Props { project: PublicProject; locale: Locale; position?: number; }
const {project:p,locale,position=1}=Astro.props;
const t=dictionary(locale); const text=p.locales[locale] ?? p.locales.en;
const category=content.categories.find(c=>c.id===p.primary_category);
---
<li data-reveal>
  <article class="project-row">
    <span class="project-index" aria-hidden="true">{String(position).padStart(2,'0')}</span>
    <div class="project-main">
      <h3 class="text-lg break-words"><a href={projectPath(p,locale)}>{p.name}</a></h3>
      {p.owner && <p class="project-owner">{p.owner}</p>}
      <p class="muted text-sm">{text.summary}</p>
      {locale==='zh'&&!p.locales.zh && <p class="text-sm text-pink">{t.missingTranslation}</p>}
    </div>
    <dl class="project-data">
      <div><dt>{locale==='zh'?'分类':'Category'}</dt><dd>{category?.[locale]??t.unknown}</dd></div>
      <div><dt>{t.stars}</dt><dd title={`${t.checked}: ${p.checked_at}`}>{p.stars===null?'—':p.stars.toLocaleString(locale)}</dd></div>
    </dl>
    <div class="project-status" aria-label={locale==='zh'?'项目状态':'Project status'}><span class="badge">{t[p.source_status]}</span><span class="badge">{t[p.ecosystem]}</span>{p.archived && <span class="badge">{t.archived}</span>}{p.requirements.local_install===true && <span class="badge">{t.local}</span>}</div>
    <div class="project-actions"><a class="button text-xs" href={projectPath(p,locale)}>{t.details} →</a>{p.repo_url&&<a class="button text-xs" href={p.repo_url} rel="noopener">GitHub ↗</a>}{p.demo_url&&<a class="button text-xs" href={p.demo_url} rel="noopener">{t.demo} ↗</a>}</div>
  </article>
</li>
