---
import type { PublicProject } from '../lib/content-schema';
import {dictionary,type Locale} from '../i18n';
import {projectPath} from '../lib/routes';
import {content} from '../lib/site';
interface Props { project: PublicProject; locale: Locale; }
const {project:p,locale}=Astro.props;
const t=dictionary(locale); const text=p.locales[locale] ?? p.locales.en;
const category=content.categories.find(c=>c.id===p.primary_category);
---
<li data-reveal>
  <article class="project-row">
    <div class="project-main">
      <span class="project-monogram" aria-hidden="true">{p.name.slice(0,1).toUpperCase()}</span>
      <div class="min-w-0"><h3 class="text-lg break-words"><a href={projectPath(p,locale)}>{p.name}</a></h3>{p.owner && <p class="project-owner">{p.owner}</p>}<p class="muted text-sm">{text.summary}</p><div class="flex flex-wrap gap-2"><span class="badge">{t[p.source_status]}</span><span class="badge">{t[p.ecosystem]}</span>{p.archived && <span class="badge">{t.archived}</span>}{p.requirements.local_install===true && <span class="badge">{t.local}</span>}</div>{locale==='zh'&&!p.locales.zh && <p class="text-sm text-pink">{t.missingTranslation}</p>}</div>
    </div>
    <div class="project-meta muted"><span>{category?.[locale]}</span>{p.stars!==null && <span title={`${t.checked}: ${p.checked_at}`}>☆ {p.stars.toLocaleString(locale)} <span>Stars</span></span>}</div>
    <div class="project-actions"><a class="button text-xs" href={projectPath(p,locale)}>{t.details} →</a>{p.repo_url&&<a class="button text-xs" href={p.repo_url} rel="noopener">GitHub ↗</a>}{p.demo_url&&<a class="button text-xs" href={p.demo_url} rel="noopener">{t.demo} ↗</a>}</div>
  </article>
</li>
