---
import { dictionary, type Locale } from '../i18n';
import { content } from '../lib/site';
import { pagePath } from '../lib/routes';
import type { PublicProject } from '../lib/content-schema';
import ProjectList from './ProjectList.astro';
interface Props { project: PublicProject; locale: Locale }
const { project: p, locale } = Astro.props;
const t = dictionary(locale);
const zh = locale === 'zh';
const text = p.locales[locale] ?? p.locales.en;
const categories = [p.primary_category, ...p.secondary_categories].map((id) => content.categories.find((c) => c.id === id)!);
const related = content.projects.filter((other) => other.id !== p.id && other.primary_category === p.primary_category).slice(0, 4);
const tristate = (value: boolean | null) => (value === null ? t.unknown : value ? t.yes : t.no);
const date = (value: string | null) => (value ? new Date(value).toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', { dateStyle: 'medium', timeZone: 'UTC' }) : t.unknown);
const sourceLabel = { repository: t.sourceTypeRepository, readme: t.sourceTypeReadme, license: t.sourceTypeLicense, website: t.sourceTypeWebsite, post: t.sourceTypePost } as const;
const ecosystemRole = { jev: t.role_jev, jev_integration: t.role_jev_integration, jev_like: t.role_jev_like, unknown: t.role_unknown }[p.ecosystem];
const facts: Array<[string, string]> = [
  [t.license, p.license ? p.license.spdx : t.unknown],
  [t.snapshot, date(p.repo_updated_at)],
  [t.archived, tristate(p.archived)],
  [t.stars, p.stars === null ? t.unknown : `☆ ${p.stars.toLocaleString(locale)}`],
  [t.firstPublished, date(p.first_published_at)],
];
---
<article class="project-detail">
  <header class="detail-header" data-reveal>
    <div class="detail-identity"><span class="detail-monogram" aria-hidden="true">{p.name.slice(0, 1).toUpperCase()}</span><div><p class="eyebrow">{categories[0]?.[locale] ?? t.projects}</p><h1>{p.name}</h1>{p.owner && <p class="muted">{t.author}: {p.owner}</p>}</div></div>
    <p class="detail-summary">{text.summary}</p>
    <div class="detail-badges flex flex-wrap gap-2">
      <span class="badge">{t[p.source_status]}</span>
      <span class="badge">{t[p.ecosystem]}</span>
      {p.archived && <span class="badge">{t.archived}</span>}
      {categories.map((category) => <a class="badge" href={pagePath(locale, `categories/${category.id}/`)}>{category[locale]}</a>)}
    </div>
    <div class="detail-actions flex flex-wrap gap-3">
      {p.repo_url && <a class="button button-primary" href={p.repo_url} rel="noopener">{t.source} ↗</a>}
      {p.demo_url && <a class="button" href={p.demo_url} rel="noopener">{t.demo} ↗</a>}
      {p.website_url && <a class="button" href={p.website_url} rel="noopener">{t.website} ↗</a>}
    </div>
  </header>

  <div class="detail-layout">
    <div class="detail-main">
      <section data-reveal><p class="section-kicker">{t.problem}</p><h2>{t.problem}</h2><p>{text.problem}</p></section>
      <section data-reveal><p class="section-kicker">{t.role}</p><h2>{t.role}</h2><p>{ecosystemRole}</p></section>
      <section data-reveal><p class="section-kicker">{t.requirements}</p><h2>{t.requirements}</h2><p>{text.requirements_text}</p></section>
      <section data-reveal>
        <p class="section-kicker">{t.provenance}</p><h2>{t.provenance}</h2>
        <p class="muted text-sm">{p.verification === 'runtime_tested' ? t.runtimeTested : t.sourceChecked} · {t.checked}: {date(p.checked_at)}</p>
        <ul class="source-list">
          {p.sources.map((source) => <li><a href={source.url} rel="noopener"><span>{sourceLabel[source.type]}</span><span>{date(source.fetched_at)} ↗</span></a><small>{source.url}</small></li>)}
          {p.runtime_evidence && <li><a href={p.runtime_evidence} rel="noopener"><span>{t.runtimeTested}</span><span>↗</span></a></li>}
        </ul>
      </section>
    </div>
    <aside class="detail-sidebar" aria-label={zh ? '项目事实' : 'Project facts'} data-reveal>
      <h2>{zh ? '项目事实' : 'Project facts'}</h2>
      <dl>{facts.map(([label2, value]) => <div><dt>{label2}</dt><dd>{value}</dd></div>)}<div><dt>{t.apiKey}</dt><dd>{tristate(p.requirements.api_key)}</dd></div><div><dt>{t.additionalModel}</dt><dd>{tristate(p.requirements.additional_model)}</dd></div><div><dt>{t.local}</dt><dd>{tristate(p.requirements.local_install)}</dd></div><div><dt>{t.hardware}</dt><dd>{p.requirements.hardware ?? t.unknown}</dd></div></dl>
      {p.license && <a class="detail-license" href={p.license.url} rel="noopener">{t.license}: {p.license.spdx} ↗</a>}
      <a class="detail-correction" href={`${pagePath(locale, 'submit/')}?project=${encodeURIComponent(p.id)}`}>{t.correct} →</a>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="related-projects" data-reveal>
      <div class="section-heading"><h2>{t.related}</h2></div>
      <ProjectList projects={related} locale={locale} />
    </section>
  )}
</article>
