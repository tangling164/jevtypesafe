---
import type {PublicProject} from '../lib/content-schema';
import type {Locale} from '../i18n';
import {dictionary} from '../i18n';
import ProjectRow from './ProjectRow.astro';
interface Props { projects: PublicProject[]; locale: Locale; }
const {projects,locale}=Astro.props;
---
{projects.length ? <ul class="project-list">{projects.map(project=><ProjectRow project={project} locale={locale}/>)}</ul> : <p class="panel muted">{dictionary(locale).noProjects}</p>}
